# Required for api/agent-recommend.ts (calls Gemini via Google Cloud Vertex AI).
# Set these as Environment Variables in the Vercel project settings — not in a local .env file.

# GCP project that has Vertex AI enabled.
GOOGLE_VERTEX_PROJECT=

# Vertex AI region. "global" is recommended.
GOOGLE_VERTEX_LOCATION=global

# Service account credentials (Vertex AI User role) — from the JSON key file.
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Optional — multi-source trend collectors degrade gracefully (return no data) if unset.

# youtubeCollector.ts — YouTube Data API v3 key.
YOUTUBE_API_KEY=

# naverCollector.ts — Naver Open API credentials. Currently deactivated (collector
# early-returns [] until both are set) — do not remove the collector code, just add
# these when the keys are ready.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
