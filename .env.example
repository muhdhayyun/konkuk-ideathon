# Required for api/agent-recommend.ts (calls Claude via Google Cloud Vertex AI).
# Set these as Environment Variables in the Vercel project settings — not in a local .env file.

# GCP project that has the Vertex AI API enabled and Claude models granted.
GCP_PROJECT_ID=

# Vertex AI region. "global" is recommended.
GCP_REGION=global

# Full JSON contents (not a file path) of a GCP service account key with
# Vertex AI User permissions. Paste the entire key file's JSON as one value.
GCP_SERVICE_ACCOUNT_KEY=
